    <xsl:key name="uat-ok"
        match="/"
        use="document('')/xsl:stylesheet/int:uat-terms/int:term"/>
    <xsl:key name="uat-warn"
        match="/"
        use="document('')/xsl:stylesheet/int:uat-deprecated/int:term"/>

    <xsl:template match="/*/content/subject" mode="voccheck">
        <xsl:variable name="term-given" select="normalize-space(.)"/>
        <xsl:choose>
            <xsl:when test="key('uat-ok', $term-given)"/>

            <xsl:when test="key('uat-warn', $term-given)">
                <xsl:call-template name="reportResult">
                    <xsl:with-param name="item">use-voc-uat</xsl:with-param>
                    <xsl:with-param name="status">false</xsl:with-param>
                    <xsl:with-param name="type">warn</xsl:with-param>
                    <xsl:with-param name="desc"
                        >#<xsl:value-of select="$term-given"
                        /> deprecated in vocabulary http://www.ivoa.net/rdf/uat
                    </xsl:with-param>
                </xsl:call-template>
            </xsl:when>

            <xsl:otherwise>
                <xsl:call-template name="reportResult">
                    <xsl:with-param name="item">use-voc-uat</xsl:with-param>
                    <xsl:with-param name="status">false</xsl:with-param>
                    <xsl:with-param name="type">fail</xsl:with-param>
                    <xsl:with-param name="desc"
                        >#<xsl:value-of select="$term-given"
                        /> not in vocabulary http://www.ivoa.net/rdf/uat
                    </xsl:with-param>
                </xsl:call-template>
            </xsl:otherwise>
        </xsl:choose>
    </xsl:template>



