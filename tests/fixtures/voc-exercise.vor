              </param>
              <param std="true">
                <name>SPECRP</name>
                <description>Lower limit to spectral resolution power (&#x3BB;/&#x394;&#x3BB;) as a single number.</description>
                <dataType xsi:type="vs:SimpleDataType">real</dataType>
              </param>
              <param std="true">
