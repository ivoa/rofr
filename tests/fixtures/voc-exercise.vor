              <queryType>GET</queryType>
              <resultType>application/x-votable+xml</resultType>
              <param std="true">
                <name>POS</name>
                <description>ICRS position of target object</description>
                <unit>deg</unit>
                <dataType arraysize="*" xsi:type="vs:SimpleDataType">char</dataType>
              </param>
              <param std="true">
                <name>SIZE</name>
                <description>Size of the region of interest around POS</description>
                <unit>deg</unit>
                <dataType xsi:type="vs:SimpleDataType">real</dataType>
              </param>
              <param std="true">
                <name>BAND</name>
                <description>Wavelength (range) of interest (or symbolic bandpass names)</description>
                <unit>m</unit>
                <dataType arraysize="*" xsi:type="vs:SimpleDataType">char</dataType>
              </param>
              <param std="true">
                <name>TIME</name>
                <description>Midpoint of exposure (MJD)</description>
                <ucd>time.epoch</ucd>
                <dataType arraysize="*" xsi:type="vs:SimpleDataType">char</dataType>
              </param>
              <param std="true">
                <name>FORMAT</name>
                <description>MIME type of the file served</description>
                <ucd>meta.code.mime</ucd>
                <dataType arraysize="*" xsi:type="vs:SimpleDataType">char</dataType>
              </param>
              <param std="true">
                <name>APERTURE</name>
